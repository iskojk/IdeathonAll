PORT=5010
NODE_ENV=development

# ====== DATABASE ======
MONGODB_URI=mongodb://localhost:27017/emlak

# ====== AUTH ======
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRE=7d

# Only for manually running src/seeds/createInitialAdmin.js.
# Supply a unique password with at least 12 characters; never commit it.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ====== MAIL ======
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

MAIL_FROM_APPLICATION_ONE=noreply@example.com
MAIL_FROM_APPLICATION_TWO=noreply@example.com

# ====== AUTH EMAIL (registration + password reset only) ======
# Set these in the private .env.auth-mail file or in the server environment.
# Keep them commented here: explicit environment values take precedence.
# AUTH_SMTP_HOST=smtp.office365.com
# AUTH_SMTP_PORT=587
# AUTH_SMTP_SECURE=false
# AUTH_SMTP_REQUIRE_TLS=true
# AUTH_SMTP_USER=sender@example.com
# AUTH_SMTP_PASS=replace-with-private-password
# AUTH_MAIL_FROM=sender@example.com
# AUTH_MAIL_FROM_NAME="AFZ-Girişimci Başvurum"
# AUTH_VERIFICATION_SECRET=replace-with-at-least-32-random-characters

# Isolated tests: use AUTH_SMTP_HOST=127.0.0.1, AUTH_SMTP_PORT=1025,
# AUTH_SMTP_SECURE=false, AUTH_SMTP_REQUIRE_TLS=false, AUTH_SMTP_USER="",
# AUTH_SMTP_PASS="", AUTH_MAIL_FROM=noreply@ideathon.dev and a separate secret.

# ====== FRONTEND URLS ======
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5010
ADMIN_PANEL_URL=http://localhost:3001
JURI_PANEL_URL=http://localhost:3002
MENTOR_PANEL_URL=http://localhost:3003
FRONTEND_MENTOR_URL=http://localhost:3003

# ====== ENCRYPTION ======
INTEGRATION_ENCRYPTION_KEY=your-32-character-strong-random-key
OAUTH_STATE_SECRET=your-64-character-strong-random-secret-key

# ====== OAUTH (Optional) ======
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5010/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5010/auth/microsoft/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:5010/auth/zoom/callback
