PORT=5010
NODE_ENV=development

# ====== DATABASE ======
MONGODB_URI=mongodb://localhost:27017/emlak

# ====== AUTH ======
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRE=7d

# Only for manually running src/seeds/createInitialAdmin.js.
# Supply a unique password with at least 12 characters; never commit it.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ====== MAIL ======
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password

MAIL_FROM_APPLICATION_ONE=noreply@example.com
MAIL_FROM_APPLICATION_TWO=noreply@example.com

# ====== FRONTEND URLS ======
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5010
ADMIN_PANEL_URL=http://localhost:3001
JURI_PANEL_URL=http://localhost:3002
MENTOR_PANEL_URL=http://localhost:3003
FRONTEND_MENTOR_URL=http://localhost:3003

# ====== ENCRYPTION ======
INTEGRATION_ENCRYPTION_KEY=your-32-character-strong-random-key
OAUTH_STATE_SECRET=your-64-character-strong-random-secret-key

# ====== OAUTH (Optional) ======
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5010/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:5010/auth/microsoft/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:5010/auth/zoom/callback
